#!/bin/sh
# Things done by hand on this server's AIshie stack, as root, with the
# images that run and the settings and mounts they run with:
#
#   aishie admin                   the first administrator: asks for a name, an email and a password
#   aishie core bootstrap --name "Your Name" --email you@example.edu --password-stdin
#   aishie core token issue --actor ID --label grader-bot --days 90
#   aishie core migrate version
#   aishie runtime check --live
#   aishie runtime migrate version
#   aishie runtime-status          the runtime's /status: its agents, seats and spend
#   aishie runtime-credential      the runtime's credential for Core issued anew, the ones before revoked
#   aishie logs SERVICE [OPTIONS]  core, runtime, web, caddy or postgres
#   aishie ps                      the stack's containers
#   aishie backup                  both databases, now, as the nightly backup does
#   aishie storage [COMMAND]       where Core keeps uploaded files, and moving them (aishie storage help)
#   aishie front-proxy             FRONT_PROXY in aishie.env applied to Caddy (Cloudflare's addresses fetched again)
#   aishie compose ARGS...         docker compose for the stack, e.g. aishie compose up -d core
#
# `aishie core ...` and `aishie runtime ...` run a one-off container of the
# image the service runs (aishie-update --status), with its env file, its
# mounts, its user and its network, and pass standard input on: a password
# given with --password-stdin is on no command line.
#
# `aishie admin` makes the first administrator: it asks for a name, an email
# and a password (twice, not shown), gives the password to Core's bootstrap
# on its standard input, and then restarts Core, so that its background jobs
# start as the system actor bootstrap creates. The administrator then signs
# in to the site with that email and password: people hold no API tokens,
# only agents do. The long form, with `aishie core bootstrap`, does the same
# in three steps.
#
# `aishie runtime-credential` gives the runtime a new credential for Core:
# in Core, the site's agent runtime is the site service agent_runtime, which
# alone hosts agents, and is issued each runtime agent's token by the
# agent's id with this credential. Core's `service issue agent_runtime
# --replace` issues it, revoking the service's others, and prints it once on
# its standard output, which goes straight into
# /etc/aishie/runtime/secrets/core/agent_runtime (the runtime reads it as
# secret://core/agent_runtime): first under another name, and checked, so
# that the file is the old credential or the new one, whole. It is never
# printed. Then the runtime is recreated, to take it. setup-server.sh runs
# this when that file is missing or empty, so it is how a lost credential
# is replaced, and a leaked one rotated.
#
# `aishie storage` is aishie-storage, beside this: where Core keeps the files
# people upload, this server's disk or a bucket, its check and CORS rule,
# and `migrate`, which moves the files from one to the other.
#
# `aishie front-proxy` is aishie-front-proxy, beside this: what stands in
# front of this server (FRONT_PROXY in aishie.env, Cloudflare), whose
# addresses Caddy believes about the visitor's, written into Caddy's
# settings, and Caddy reloaded when they changed. aishie-front-proxy.timer
# runs it every week, which fetches Cloudflare's addresses again.
#
# `aishie backup` is what aishie-backup.timer runs every night: the two
# databases dumped to /var/backups/aishie/SERVICE-daily-N.dump, N the day of
# the week (1 to 7), so that seven are kept.
#
# The variables that move the paths below are for the tests
# (tests/aishie_test.sh).
set -eu
# The backups are root's alone.
umask 077

ETC=${AISHIE_ETC:-/etc/aishie}
STATE=${AISHIE_STATE:-/var/lib/aishie}
APP=${AISHIE_APP:-/opt/aishie}
BACKUPS=${AISHIE_BACKUPS:-/var/backups/aishie}
LOCK_FILE=${AISHIE_LOCK_FILE:-/run/aishie-update.lock}
# The image stack.yaml's Caddy runs, which has a wget.
CADDY_IMAGE=caddy:2
# The images' nonroot user (distroless), which the runtime runs as.
APP_UID=65532
# The runtime's credential for Core, secret://core/agent_runtime in the
# runtime's secrets directory (its CORE_SERVICE_CREDENTIAL by default).
CREDENTIAL=$ETC/runtime/secrets/core/agent_runtime

# compose.yaml reads these from aishie.env and images.env, and the same
# names in this process's environment would win over both files.
unset HOST ENVIRONMENT CORE_IMAGE RUNTIME_IMAGE WEB_IMAGE CORE_REF RUNTIME_REF WEB_REF \
  AISHIE_SUBNET AISHIE_CADDY_IP RUNTIME_STOP_GRACE FRAME_ANCESTORS
export AISHIE_ETC="$ETC" AISHIE_STATE="$STATE"

usage() {
  echo "usage:" >&2
  sed -n 's/^#   \(aishie .*\)/  \1/p' "$0" >&2
  exit 2
}
die() { echo "aishie: $*" >&2; exit 1; }
upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }
setting() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tr -d '\r' | tail -n 1; }
compose() { docker compose --project-directory "$APP" -f "$APP/compose.yaml" "$@"; }

# backup: both databases, by pg_dump in PostgreSQL's container, each under
# another name until it is whole: a dump cut short is not a backup. One that
# fails leaves last week's of the same day in place.
backup() {
  # Not in the middle of a deploy, which takes its own backup.
  exec 9>"$LOCK_FILE"
  flock -w 3600 9 || die "aishie-update has held the lock for an hour: no backup taken (journalctl -u aishie-update)"
  [ -n "$(compose ps -q postgres)" ] || die "PostgreSQL is not running (aishie ps): no backup taken"
  mkdir -p "$BACKUPS"
  day=$(date +%u)
  rc=0
  for s in core runtime; do
    f=$BACKUPS/$s-daily-$day.dump
    if compose exec -T postgres pg_dump -U postgres -Fc "aishie_$s" > "$f.part" && [ -s "$f.part" ]; then
      mv "$f.part" "$f"
      echo "aishie_$s backed up: $f"
    else
      rm -f "$f.part"
      echo "aishie: the backup of aishie_$s failed (above); the last one of day $day, if any, is still $f" >&2
      rc=1
    fi
  done
  exit "$rc"
}

# ask PROMPT: a line from standard input, in $ans. secret PROMPT: the same,
# not shown as it is typed when standard input is a terminal.
ask() {
  printf '%s' "$1" >&2
  IFS= read -r ans || [ -n "$ans" ] || die "no answer: nothing was changed"
}
secret() {
  printf '%s' "$1" >&2
  if [ -t 0 ]; then
    # Echo comes back however this ends, Ctrl-C included.
    trap 'stty echo 2>/dev/null' EXIT
    trap 'exit 130' INT TERM
    stty -echo
    IFS= read -r ans || :
    stty echo
    echo >&2
  else
    IFS= read -r ans || :
  fi
}

# admin: the first administrator, as the header says. The password is on no
# command line and in no output. Bootstrap's standard output goes nowhere: a
# Core from before people held no API tokens prints one for the
# administrator there, which nobody needs, and which is neither shown nor
# kept. What it says on standard error is shown, but for that token's
# heading.
admin() {
  [ -n "$(setting "$STATE/images.env" CORE_REF)" ] ||
    die "core is not deployed yet: aishie-update deploys it (aishie-update --status)"
  ask 'Name: '
  name=$ans
  [ -n "$name" ] || die "a name is needed: nothing was changed"
  ask 'Email (to sign in with): '
  email=$ans
  case $email in ?*@?*.?*) ;; *) die "«$email» is not an email address: nothing was changed" ;; esac
  secret 'Password (10 characters or more): '
  pw=$ans
  [ "${#pw}" -ge 10 ] || die "the password is shorter than 10 characters: nothing was changed"
  secret 'The password again: '
  [ "$ans" = "$pw" ] || die "the two passwords differ: nothing was changed"
  ans=
  said=$(printf '%s\n' "$pw" | compose run --rm --no-deps -T core bootstrap --name "$name" --email "$email" --password-stdin 2>&1 >/dev/null) || {
    printf '%s\n' "$said" >&2
    die "bootstrap failed (above): Core was not restarted"
  }
  pw=
  printf '%s\n' "$said" | grep -v '^API token for ' >&2 || :
  echo "aishie: restarting Core, so that its background jobs start" >&2
  compose restart core >&2
  host=$(setting "$ETC/aishie.env" HOST)
  cat >&2 <<EOF
aishie: done. Sign in at https://$host with $email and that password.
EOF
}

# runtime_credential: the runtime's credential for Core, as the header says.
# The credential goes from Core's standard output into the file, root's
# alone (0600) until it is whole and checked, then the runtime's user's,
# still 0600, in a directory root's and the runtime's group's, as the rest
# of the secrets directory is; the runtime mounts it read-only. Core's
# standard error, what it issued and how many it revoked, is shown, without
# its last words: the credential it says it shows once goes nowhere else.
runtime_credential() {
  [ -n "$(setting "$STATE/images.env" CORE_REF)" ] ||
    die "core is not deployed yet: aishie-update deploys it (aishie-update --status)"
  # Not in the middle of a deploy: Core's migrations, or the runtime's
  # recreate.
  exec 9>"$LOCK_FILE"
  flock -w 600 9 || die "aishie-update has held the lock for ten minutes: nothing was changed (journalctl -u aishie-update)"
  f=$CREDENTIAL
  dir=${f%/*}
  if [ ! -d "$dir" ]; then
    install -d -m 750 "$dir"
    chown "root:$APP_UID" "$dir"
  fi
  rm -f "$f.new"
  said=$(compose run --rm --no-deps -T core service issue agent_runtime --label runtime --replace 2>&1 >"$f.new" </dev/null) || {
    rm -f "$f.new"
    printf '%s\n' "$said" >&2
    die "Core issued no credential (above): $f is left as it was, and so is the runtime"
  }
  # One line, and a site service's credential: anything else is not kept,
  # and not shown either.
  if [ "$(wc -l < "$f.new")" != 1 ] || ! grep -Eqx 'aissvc_[A-Za-z0-9_-]+' "$f.new"; then
    rm -f "$f.new"
    die "Core's answer is not a site service's credential (aissvc_...): it is not kept, and $f is left as it was. Core has revoked the ones before all the same: run this again"
  fi
  chmod 600 "$f.new"
  chown "$APP_UID:$APP_UID" "$f.new"
  mv "$f.new" "$f"
  [ -z "$said" ] || printf '%s\n' "$said" | sed 's/, shown once:$//'
  echo "aishie: kept in $f, which the runtime reads as secret://core/agent_runtime; Core revoked any other the service held"
  if [ -z "$(setting "$STATE/images.env" RUNTIME_REF)" ]; then
    echo "aishie: the runtime is not deployed yet, and reads it once aishie-update deploys it"
    return 0
  fi
  # Recreated, not restarted: so it starts afresh with what it reads.
  compose up -d --no-deps --force-recreate runtime ||
    die "the runtime could not be recreated (above): it has the credential once it is (aishie compose up -d --force-recreate runtime)"
  echo "aishie: the runtime recreated, with it"
}

case ${1:-} in
  admin)
    [ $# -eq 1 ] || usage
    admin
    ;;
  runtime-credential)
    [ $# -eq 1 ] || usage
    runtime_credential
    ;;
  core | runtime)
    s=$1
    shift
    [ $# -gt 0 ] || die "usage: aishie $s COMMAND..., e.g. aishie $s migrate version (aishie $s help lists them)"
    [ -n "$(setting "$STATE/images.env" "$(upper "$s")_REF")" ] ||
      die "$s is not deployed yet: aishie-update deploys it (aishie-update --status)"
    exec docker compose --project-directory "$APP" -f "$APP/compose.yaml" run --rm --no-deps -T "$s" "$@"
    ;;
  runtime-status)
    [ $# -eq 1 ] || usage
    id=$(compose ps -q runtime)
    [ -n "$id" ] || die "the runtime is not running (aishie ps)"
    # /status answers the runtime's own loopback alone, not the host's
    # published port: a wget, from Caddy's image, in the runtime's network
    # namespace, is on it.
    exec docker run --rm --network "container:$id" --entrypoint wget "$CADDY_IMAGE" -qO- http://127.0.0.1:9090/status
    ;;
  logs)
    shift
    [ $# -gt 0 ] || die "usage: aishie logs SERVICE [docker compose logs options], SERVICE core, runtime, web, caddy or postgres"
    if [ $# -eq 1 ]; then set -- -f --tail 100 "$1"; fi
    exec docker compose --project-directory "$APP" -f "$APP/compose.yaml" logs "$@"
    ;;
  ps)
    shift
    exec docker compose --project-directory "$APP" -f "$APP/compose.yaml" ps "$@"
    ;;
  compose)
    shift
    exec docker compose --project-directory "$APP" -f "$APP/compose.yaml" "$@"
    ;;
  backup)
    [ $# -eq 1 ] || usage
    backup
    ;;
  storage)
    shift
    exec "$(dirname "$0")/aishie-storage" "$@"
    ;;
  front-proxy)
    shift
    exec "$(dirname "$0")/aishie-front-proxy" "$@"
    ;;
  *) usage ;;
esac
