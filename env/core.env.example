# /etc/aishie/core.env: AIShie Core's settings on this server, root's alone
# (0600). setup-server.sh writes it once, with the database password and a
# generated SIGNING_KEY, and never overwrites it. Core's own documentation
# (docs/deploying.md, and `aishie core help`) says what each setting does.
#
# One NAME=value per line: no quotes, no export, and no comment after a value,
# which Docker would take as part of it. To apply a change, recreate Core
# with the image it runs: aishie compose up -d core

# Core's database on the stack's PostgreSQL, as the role aishie_core. The
# password is AISHIE_CORE_DB_PASSWORD in postgres.env.
DATABASE_URL=postgres://aishie_core:<password>@postgres:5432/aishie_core?sslmode=disable

# Signs the upload and download links Core gives out, and single sign-on's
# state: 32 characters or more. It must never change, or every link given
# out stops working. Keep a copy off the server (README.md, What to keep off
# the server).
SIGNING_KEY=<generated: openssl rand -hex 32>

# The files people upload, under /data, which is /srv/aishie/core on the
# server. S3 instead: BLOB_STORE=s3 and the S3_* settings below.
BLOB_STORE=fs
BLOB_FS_ROOT=/data/blobs

# Set by stack.yaml from aishie.env, whatever this file says:
#   HTTP_ADDR=:8080
#   PUBLIC_URL=https://HOST
#   TRUSTED_PROXIES=AISHIE_CADDY_IP/32, Caddy alone
#   RUNTIME_AUDIENCES=https://HOST/runtime (for the runtime's API, M2)

# Optional; Core's defaults stand while they are unset.
# TRUSTED_ORIGINS=              a front end on another origin; this stack serves it on HOST
# COOKIE_SAMESITE=lax           none only for a front end on another site
# SESSION_TTL=12h
# PROPOSAL_TTL=336h             0 turns expiry off
# RATE_LIMIT_PER_MINUTE=600     per actor; 0 for no limit
# RATE_LIMIT_BURST=100
# SIGN_IN_ATTEMPTS_PER_MINUTE=10
# JOBS=true                     the background sweeps
# JOBS_INTERVAL=1m
# SHUTDOWN_GRACE=15s            keep it under stop_grace_period in stack.yaml (20s)
# MAX_UPLOAD_BYTES=52428800
# AGENT_SELF_SERVICE=on         off: only administrators register agents
# AGENT_MAX_PER_OWNER=5
# S3_ENDPOINT=  S3_BUCKET=  S3_REGION=us-east-1  S3_ACCESS_KEY=  S3_SECRET_KEY=  S3_USE_SSL=true
# OIDC_ISSUER=                  turns single sign-on on; for ADFS, https://<host>/adfs
# OIDC_CLIENT_ID=  OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=polyu-adfs
# OIDC_SUBJECT_CLAIM=upn
# OIDC_SCOPES=openid profile email
