# /etc/aishie/core.env: AIshie Core's settings on this server, root's alone
# (0600). setup-server.sh writes it once, with the database password and a
# generated SIGNING_KEY, and never overwrites it. Core's own documentation
# (docs/deploying.md, and `aishie core help`) says what each setting does.
#
# One NAME=value per line: no export, and no comment after a value. Docker
# Compose reads it, and takes each value as written, spaces included, but for
# a $, which starts a variable to put in its place: a value with a $ in it,
# such as a secret someone gives you, goes in single quotes, 'like$this',
# which Compose takes as it is.
# To apply a change, recreate Core with the image it runs:
# aishie compose up -d core

# Core's database on the stack's PostgreSQL, as the role aishie_core. The
# password is AISHIE_CORE_DB_PASSWORD in postgres.env.
DATABASE_URL=postgres://aishie_core:<password>@postgres:5432/aishie_core?sslmode=disable

# Signs the upload and download links Core gives out, and single sign-on's
# state: 32 characters or more. It must never change, or every link given
# out stops working. Keep a copy off the server (README.md, What to keep off
# the server).
SIGNING_KEY=<generated: openssl rand -hex 32>

# The files people upload: on this server's disk (fs), under /data, which
# is /srv/aishie/core on the server, where every upload and download goes
# through the server; or in a bucket (s3), which browsers upload to and
# download from directly, by links Core signs. setup-server.sh writes these
# lines, and `aishie storage migrate` moves the files and rewrites them
# (README.md, Where uploaded files are kept). BLOB_FS_ROOT stays with s3,
# for a move back.
BLOB_STORE=fs
BLOB_FS_ROOT=/data/blobs
# With BLOB_STORE=s3, which alone makes Core read these:
# S3_ENDPOINT=                  HOST[:PORT], no scheme: s3.<region>.amazonaws.com (AWS),
#                               <account>.r2.cloudflarestorage.com (R2), s3.<region>.backblazeb2.com (B2)
# S3_BUCKET=
# S3_REGION=us-east-1           the bucket's; auto for R2
# S3_ACCESS_KEY=
# S3_SECRET_KEY=                in single quotes if it has a $ in it
# S3_USE_SSL=true               browsers refuse an http:// bucket from the site's https:// pages

# Set by stack.yaml from aishie.env, whatever this file says:
#   HTTP_ADDR=:8080
#   PUBLIC_URL=https://HOST
#   TRUSTED_PROXIES=AISHIE_CADDY_IP/32, Caddy alone
#   RUNTIME_AUDIENCES=https://HOST/runtime (for the runtime's API, M2)

# Single sign-on, optional: on exactly when OIDC_ISSUER is set. Register
# https://HOST/v1/auth/sso/callback (HOST from aishie.env) with the identity
# provider as the redirect URI, and give Core the client it issues (a client
# secret with a $ in it goes in single quotes, above).
# OIDC_ISSUER=                  for ADFS, https://<the ADFS host>/adfs
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# The provider's name on the sign-in page's button, such as PolyU NetID: at
# most 64 printable characters, or Core does not start. Unset, the front end
# uses words of its own. The front end asks Core at GET /v1/auth/methods
# whether to show the button and what it says, so nothing about single
# sign-on is built into the web image.
# OIDC_DISPLAY_NAME=PolyU NetID
# OIDC_PROVIDER_NAME=polyu-adfs what actor.link_sso calls the provider
# OIDC_SUBJECT_CLAIM=upn        the claim an account is known by
# OIDC_SCOPES=openid profile email

# Optional; Core's defaults stand while they are unset.
# TRUSTED_ORIGINS=              a front end on another origin; this stack serves it on HOST
# COOKIE_SAMESITE=lax           none when another site frames AIshie (FRAME_ANCESTORS in
#                               aishie.env): inside a cross-site frame, Core's session
#                               cookie is a third-party cookie, which the browser sends
#                               only when it is SameSite=None; Safari, and every browser
#                               on iOS, refuses it even then
# SESSION_TTL=12h
# PROPOSAL_TTL=336h             0 turns expiry off
# RATE_LIMIT_PER_MINUTE=600     per actor; 0 for no limit
# RATE_LIMIT_BURST=100
# SIGN_IN_ATTEMPTS_PER_MINUTE=10
# JOBS=true                     the background sweeps
# JOBS_INTERVAL=1m
# SHUTDOWN_GRACE=15s            keep it under stop_grace_period in stack.yaml (20s)
# MAX_UPLOAD_BYTES=52428800
# AGENT_SELF_SERVICE=on         off: only administrators register agents
# AGENT_MAX_PER_OWNER=5
# ASSERTION_KEY=                the runtime's assertions' own key (openssl rand -base64 32);
#                               unset, one derived from SIGNING_KEY; kept like SIGNING_KEY
# ASSERTION_TTL=5m              from 1m to 15m
