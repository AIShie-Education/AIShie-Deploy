# /etc/aishie/runtime.env: the AIShie Agent Runtime's settings on this
# server, root's alone (0600). setup-server.sh writes it once, with the
# database password, and never overwrites it. The runtime's own documentation
# (docs/deploying.md, and `aishie runtime help`) says what each setting does.
#
# One NAME=value per line: no export, and no comment after a value. Docker
# Compose reads it, and takes each value as written, spaces included, but for
# a $, which starts a variable to put in its place: a value with a $ in it,
# such as a secret someone gives you, goes in single quotes, 'like$this',
# which Compose takes as it is.
# To apply a change, recreate the runtime with the image it runs:
# aishie compose up -d runtime
#
# The agents are YAML files in /etc/aishie/runtime/agents, and the secrets
# they refer to (secret://a/b) are files in /etc/aishie/runtime/secrets
# (README.md, Adding an agent).

# The runtime's own database, never Core's, as the role aishie_runtime. The
# password is AISHIE_RUNTIME_DB_PASSWORD in postgres.env.
DATABASE_URL=postgres://aishie_runtime:<password>@postgres:5432/aishie_runtime?sslmode=disable

LOG_FORMAT=json

# For the runtime's API (M2): the key that wraps the secrets it stores, a
# file in the secrets directory (32 random bytes, base64) that
# setup-server.sh creates when it is missing. The runtime reads it once it has
# that API; until then, nothing does. It must not be lost, and it is kept off
# the server apart from the database's backups (README.md).
KMS_KEY_ID=local:/secrets/kek/v1

# Set by stack.yaml from aishie.env, whatever this file says:
#   HTTP_ADDR=:9090                  /healthz, /metrics, /status; host loopback only
#   CONFIG=/config                   /etc/aishie/runtime/agents, read-only
#   SECRETS_DIR=/secrets             /etc/aishie/runtime/secrets, read-only
#   CORE_BASE_URL_ALLOWLIST=https://HOST
#   API_ADDR=:9091, API_AUDIENCE=https://HOST/runtime, CORE_BASE_URL=https://HOST,
#   API_TRUSTED_PROXIES=AISHIE_CADDY_IP/32 (M2)

# Optional; the runtime's defaults stand while they are unset.
# LOG_LEVEL=info
# LOG_REDACT_EXTRA=              comma-separated regular expressions removed from every log line
# EGRESS_PROXY=                  the proxy for every call out (http://, https://, socks5://)
# SHUTDOWN_GRACE=15s             then RUNTIME_STOP_GRACE in aishie.env: 15 seconds more
# WORKER_ID=                     this worker's name in the leases
# PRICES=                        a price table's path, e.g. /config/prices.yaml
# AISHIE_SECRET_A_B=             secret://a/b when there is no file a/b in the secrets directory
