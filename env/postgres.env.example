# /etc/aishie/postgres.env: the stack's PostgreSQL, root's alone (0600).
# setup-server.sh writes it once, with generated passwords, together with
# core.env and runtime.env, which hold the same passwords in their
# DATABASE_URL; it never overwrites it.
#
# The passwords are read when the database volume is first made, and not
# after: changing one here changes nothing in the database (README.md,
# Rotating secrets).

# The superuser, postgres. Nothing in the stack connects as postgres over the
# network: backups run pg_dump inside the container, on its socket.
POSTGRES_PASSWORD=<generated: openssl rand -hex 24>

# The roles aishie_core and aishie_runtime, each the owner of the database of
# the same name (postgres/initdb/10-aishie.sh).
AISHIE_CORE_DB_PASSWORD=<generated: openssl rand -hex 24>
AISHIE_RUNTIME_DB_PASSWORD=<generated: openssl rand -hex 24>
